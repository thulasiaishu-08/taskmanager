# Copy this file to .env and adjust before running `docker-compose up --build`

# PostgreSQL
POSTGRES_USER=taskmanager
POSTGRES_PASSWORD=taskmanager
POSTGRES_DB=taskmanager
POSTGRES_PORT=5432

# Backend
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
BACKEND_PORT=8000

# Frontend (must be a URL reachable from the browser, not the Docker network)
VITE_API_URL=http://localhost:8000
FRONTEND_PORT=5173
